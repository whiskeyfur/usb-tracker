[Unit]
Description=USB Tracker background recorder
Documentation=https://github.com/whiskeyfur/usb-tracker

[Service]
Type=simple
# Adjust the path if you keep the checkout somewhere else.
WorkingDirectory=%h/claude-projects/usb-tracker
ExecStart=/usr/bin/python3 -m usbtracker --daemon --interval 1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
